import cv2
import numpy as np
import tensorflow as tf
from mtcnn.mtcnn import MTCNN
import logging

# Configure logging for this module
logger = logging.getLogger(__name__)

class FaceEyeDetector:
    """
    A class to handle face and eye detection using MTCNN.
    """
    def __init__(self):
        logger.info("Initializing MTCNN face detector...")
        # MTCNN uses TensorFlow internally. Ensure GPU is configured in the main app if available.
        self.detector = MTCNN()
        logger.info("MTCNN face detector initialized.")

    def detect_and_crop_face(self, image_np_rgb, target_size=(80, 80)):
        """
        Detects faces in an RGB image, crops the largest face, and resizes it.

        Args:
            image_np_rgb (np.array): The input image as a NumPy array in RGB format.
            target_size (tuple): The desired output size for the cropped face (width, height).

        Returns:
            np.array: The preprocessed (cropped, resized, normalized) face image,
                      or None if no face is detected or preprocessing fails.
        """
        if image_np_rgb is None or image_np_rgb.size == 0:
            logger.error("Input image for face detection is empty or None.")
            return None

        # Perform face detection
        faces = self.detector.detect_faces(image_np_rgb)

        if not faces:
            logger.warning("No face detected in the image.")
            return None

        # Find the largest face (assuming the main subject is the largest)
        largest_face = None
        max_area = 0
        for face in faces:
            x, y, width, height = face['box']
            area = width * height
            if area > max_area:
                max_area = area
                largest_face = face

        if largest_face is None:
            logger.warning("Could not determine largest face.")
            return None

        # Get bounding box coordinates for the largest face
        x, y, width, height = largest_face['box']

        # Ensure coordinates are within image bounds
        img_h, img_w, _ = image_np_rgb.shape
        x1, y1 = max(0, x), max(0, y)
        x2, y2 = min(img_w, x + width), min(img_h, y + height)

        # Crop the face from the original image
        cropped_face = image_np_rgb[y1:y2, x1:x2]

        if cropped_face.size == 0:
            logger.warning("Cropped face region is empty after bounding box adjustment.")
            return None

        # Resize the cropped face to the model's input shape
        resized_image = cv2.resize(cropped_face, target_size)

        # Normalize pixel values to 0-1
        image_array = resized_image.astype('float32') / 255.0

        return image_array

    def get_face_landmarks(self, image_np_rgb):
        """
        Detects faces and returns their bounding boxes and keypoints.
        This is useful if the frontend needs to draw overlays.

        Args:
            image_np_rgb (np.array): The input image as a NumPy array in RGB format.

        Returns:
            list: A list of dictionaries, each containing 'box' and 'keypoints' for a detected face.
                  Returns an empty list if no faces are detected.
        """
        if image_np_rgb is None or image_np_rgb.size == 0:
            logger.error("Input image for landmark detection is empty or None.")
            return []

        faces = self.detector.detect_faces(image_np_rgb)
        
        # Format the results to be easily JSON serializable if needed by Flask
        formatted_faces = []
        for face in faces:
            formatted_faces.append({
                'box': [int(val) for val in face['box']], # Ensure integers for JSON
                'keypoints': {key: [int(val) for val in value] for key, value in face['keypoints'].items()},
                'confidence': float(face['confidence'])
            })
        return formatted_faces

